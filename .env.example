# Hugging Face deployment/auth
HF_TOKEN=
HF_SPACE_ID=arjun10g/rag-architecture-advisor

# LLM generation
# Default uses Hugging Face Inference Providers. Set LLM_PROVIDER=disabled for
# deterministic no-network output while preserving the same structured decisions.
LLM_PROVIDER=hf
HF_INFERENCE_PROVIDER=auto
HF_INFERENCE_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_INFERENCE_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.15
LLM_RETRIES=1
# quality uses the configured Llama model. fast skips the external generation
# call and returns the deterministic, citation-grounded advisor narrative.
ADVISOR_LATENCY_PROFILE=quality

# Latency SLOs for scripts/api_output_probe.py. Current hosted hybrid/Qdrant
# profile uses remote HF feature-extraction embeddings and targets p50 <= 12s
# and p99 <= 20s. Deep-thinking/full-text mode has a larger budget because it
# runs parallel research agents and reads selected public references.
LATENCY_SLO_P50_MS=12000
LATENCY_SLO_P99_MS=20000
DEEP_LATENCY_SLO_P50_MS=25000
DEEP_LATENCY_SLO_P99_MS=35000

# Deep research fetches and summarizes full public references by default. Disable
# only for deterministic offline CI or no-network deployments.
DEEP_RESEARCH_FULL_TEXT=true
DEEP_RESEARCH_RETRIEVAL_MODE=lexical
DEEP_RESEARCH_MAX_FULL_TEXT_LINKS=4
DEEP_RESEARCH_FETCH_WORKERS=4
DEEP_RESEARCH_FETCH_TIMEOUT_SECONDS=6
DEEP_RESEARCH_MAX_FETCH_BYTES=2000000
DEEP_RESEARCH_CACHE_DIR=.cache/deep_research

# Gradio runtime
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
SHOW_RAW_TRACE=false
PUBLIC_ACCESS_MODE=private
ALLOW_ANONYMOUS_PUBLIC=false

# Optional production auth. Leave empty for local development or a public demo.
# Set both values in production, preferably as deployment secrets.
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=
# Set true only when an upstream gateway enforces authentication.
EXTERNAL_AUTH_GATEWAY=false

# Optional process-local rate limiter. Keep disabled for local development.
# Production should enable this or place the app behind an authenticated gateway
# with equivalent request limits.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_IDENTITY=true
RATE_LIMIT_IDENTITY_SALT=
TRUST_PROXY_HEADERS=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX_REQUESTS=0
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_ADVISOR_MAX_REQUESTS=8
RATE_LIMIT_ADVISOR_WINDOW_SECONDS=60
RATE_LIMIT_ADVISOR_DEEP_MAX_REQUESTS=6
RATE_LIMIT_ADVISOR_DEEP_WINDOW_SECONDS=300
# Set true only when an upstream gateway enforces rate limits.
EXTERNAL_RATE_LIMITING=false
# Serving-capacity controls. Keep these low on CPU-basic Spaces; raise only
# after the live load probe passes on the chosen hardware.
ADVISOR_CONCURRENCY_LIMIT=2
ADVISOR_QUEUE_MAX_SIZE=32

# Public request bounds and cost controls.
MAX_BRIEF_CHARS=4000
MAX_ELICITATION_CHARS=2000
MAX_CONFLICT_CHARS=1000
DEEP_THINKING_ENABLED=true

# Anonymous public profile: set PUBLIC_ACCESS_MODE=anonymous,
# ALLOW_ANONYMOUS_PUBLIC=true, DEEP_THINKING_ENABLED=false, and keep the
# per-identity/request-budget controls below on persistent storage.
DAILY_REQUEST_BUDGET=250
MONTHLY_REQUEST_BUDGET=3000
DAILY_DEEP_REQUEST_BUDGET=0
MONTHLY_DEEP_REQUEST_BUDGET=0
ADVISOR_USAGE_COUNTER_PATH=
ADVISOR_REQUEST_LOG_PATH=
ADVISOR_ALERT_LOG_PATH=
REQUEST_ALERT_WINDOW_SECONDS=300
REQUEST_ALERT_MAX_REQUESTS=50
REQUEST_ALERT_LATENCY_MS=20000

# Optional production audit log. Leave empty locally; set to a JSONL path in a
# deployment that needs persisted advisor traces.
# On Hugging Face Spaces with persistent storage enabled, use a mounted path
# such as /data/advisor-audit.jsonl.
ADVISOR_AUDIT_LOG_PATH=
# fail is recommended in production so missing audit persistence is visible.
ADVISOR_AUDIT_FAILURE_MODE=warn

# Process-local metrics exposed through the Gradio /metrics API endpoint.
# Set this as a deployment secret before public launch.
METRICS_AUTH_TOKEN=
OBSERVABILITY_SAMPLE_LIMIT=200

# Retrieval defaults
# Keep lexical as the default for CI and local no-download smoke tests.
# Recommended production quality profile after optional ML deps/model cache are
# available: RETRIEVAL_MODE=hybrid with VECTOR_STORE_BACKEND=qdrant or lancedb
# and EMBEDDING_DIM=1024.
# Recommended speed profile for dense-only experiments: RETRIEVAL_MODE=dense with EMBEDDING_DIM=512.
RETRIEVAL_MODE=lexical
RETRIEVAL_STRICT_DENSE=false
FINAL_TOP_K=8
# Share one dense semantic query across the four specialist retrieval passes
# while keeping specialist-specific lexical queries.
SPECIALIST_SHARED_DENSE_QUERY=true
# Load the retriever and embedding model during app startup so the first user
# request does not pay the dense-query cold-start cost.
PREWARM_RETRIEVER=false

# Vector store
# memory is dependency-light and builds vectors into a Python list.
# lancedb persists a deployable local vector table under VECTOR_INDEX_DIR.
# qdrant uses a managed Qdrant Cloud cluster or a local Qdrant path.
VECTOR_STORE_BACKEND=memory
VECTOR_INDEX_DIR=corpus/index/lancedb
# Optional source index copied into VECTOR_INDEX_DIR when a mounted volume starts empty.
VECTOR_INDEX_BOOTSTRAP_DIR=
VECTOR_TABLE_NAME=chunks
VECTOR_INDEX_DIMS=1024,512

# Optional Qdrant Cloud/data-plane settings.
# QDRANT_CLOUD_KEY is the management key used only by scripts/qdrant_cloud_bootstrap.py.
# QDRANT_API_KEY is the database key used by the app/runtime.
QDRANT_CLOUD_ACCOUNT_ID=
QDRANT_CLOUD_KEY=
QDRANT_CLUSTER_ID=
QDRANT_CLUSTER_NAME=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_UPLOAD_BATCH_SIZE=128
QDRANT_LIVE_TABLE_NAME=rag_advisor_chunks_live
QDRANT_TARGET_TABLE=rag_advisor_chunks
QDRANT_REQUIRE_ALIASES=false

# Matryoshka embedding path
EMBEDDING_PROVIDER=local
EMBEDDING_HF_PROVIDER=auto
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_NATIVE_DIM=1024
EMBEDDING_DIMS=1024,768,512,384,256
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# Hybrid dense + lexical fusion
LEXICAL_TOP_K=100
DENSE_TOP_K=100
FUSION_RRF_K=60
LEXICAL_WEIGHT=1.0
DENSE_WEIGHT=1.0

# Optional reranker placeholder
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=40

# Optional ColBERT reranking for offline/VM ablations
COLBERT_MODEL=answerdotai/answerai-colbert-small-v1
COLBERT_DEVICE=
COLBERT_CANDIDATE_TOP_K=50
