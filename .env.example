# Hugging Face deployment/auth
HF_TOKEN=
HF_SPACE_ID=arjun10g/rag-architecture-advisor

# Gradio runtime
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Retrieval defaults
# Keep lexical as the default for CI and local no-download smoke tests.
RETRIEVAL_MODE=lexical
RETRIEVAL_STRICT_DENSE=false
FINAL_TOP_K=8

# Matryoshka embedding path
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_NATIVE_DIM=1024
EMBEDDING_DIMS=1024,768,512,384,256
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# Hybrid dense + lexical fusion
LEXICAL_TOP_K=100
DENSE_TOP_K=100
FUSION_RRF_K=60
LEXICAL_WEIGHT=1.0
DENSE_WEIGHT=1.0

# Optional reranker placeholder
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=40
