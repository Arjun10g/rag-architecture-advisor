# Hugging Face deployment/auth
HF_TOKEN=
HF_SPACE_ID=arjun10g/rag-architecture-advisor

# LLM generation
# Default uses Hugging Face Inference Providers. Set LLM_PROVIDER=disabled for
# deterministic no-network output while preserving the same structured decisions.
LLM_PROVIDER=hf
HF_INFERENCE_PROVIDER=auto
HF_INFERENCE_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_INFERENCE_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.15
LLM_RETRIES=1
# quality uses the configured Llama model. fast skips the external generation
# call and returns the deterministic, citation-grounded advisor narrative.
ADVISOR_LATENCY_PROFILE=quality

# Latency SLOs for scripts/api_output_probe.py. Current standard hosted target:
# p50 <= 10s and p99 <= 15s. Deep-thinking mode is allowed a larger budget
# because it runs parallel literature/community agents before synthesis.
LATENCY_SLO_P50_MS=10000
LATENCY_SLO_P99_MS=15000
DEEP_LATENCY_SLO_P50_MS=18000
DEEP_LATENCY_SLO_P99_MS=30000

# Gradio runtime
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
SHOW_RAW_TRACE=false

# Optional production auth. Leave empty for local development or a public demo.
# Set both values in production, preferably as deployment secrets.
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=
# Set true only when an upstream gateway enforces authentication.
EXTERNAL_AUTH_GATEWAY=false

# Optional process-local rate limiter. Keep disabled for local development.
# Production should enable this or place the app behind an authenticated gateway
# with equivalent request limits.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Set true only when an upstream gateway enforces rate limits.
EXTERNAL_RATE_LIMITING=false

# Optional production audit log. Leave empty locally; set to a JSONL path in a
# deployment that needs persisted advisor traces.
# On Hugging Face Spaces with persistent storage enabled, use a mounted path
# such as /data/advisor-audit.jsonl.
ADVISOR_AUDIT_LOG_PATH=

# Retrieval defaults
# Keep lexical as the default for CI and local no-download smoke tests.
# Recommended production quality profile after optional ML deps/model cache are
# available: RETRIEVAL_MODE=hybrid with VECTOR_STORE_BACKEND=lancedb and
# EMBEDDING_DIM=1024.
# Recommended speed profile for dense-only experiments: RETRIEVAL_MODE=dense with EMBEDDING_DIM=512.
RETRIEVAL_MODE=lexical
RETRIEVAL_STRICT_DENSE=false
FINAL_TOP_K=8

# Vector store
# memory is dependency-light and builds vectors into a Python list.
# lancedb persists a deployable local vector table under VECTOR_INDEX_DIR.
VECTOR_STORE_BACKEND=memory
VECTOR_INDEX_DIR=corpus/index/lancedb
VECTOR_TABLE_NAME=chunks
VECTOR_INDEX_DIMS=1024,512

# Matryoshka embedding path
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_NATIVE_DIM=1024
EMBEDDING_DIMS=1024,768,512,384,256
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# Hybrid dense + lexical fusion
LEXICAL_TOP_K=100
DENSE_TOP_K=100
FUSION_RRF_K=60
LEXICAL_WEIGHT=1.0
DENSE_WEIGHT=1.0

# Optional reranker placeholder
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=40

# Optional ColBERT reranking for offline/VM ablations
COLBERT_MODEL=answerdotai/answerai-colbert-small-v1
COLBERT_DEVICE=
COLBERT_CANDIDATE_TOP_K=50
